{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(python3 -c ' *)",
      "Bash(sort -k6,7)",
      "Bash(npx tsx *)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git merge *)",
      "Bash(git stash *)",
      "Bash(git rev-parse *)",
      "Bash(git worktree *)",
      "Bash(node *)",
      "Bash(jq *)",
      "Bash(grep *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sed -n *)",
      "Bash(find *)",
      "Bash(lsof *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git push)"
    ],
    "defaultMode": "bypassPermissions",
    "additionalDirectories": [
      "/private/tmp",
      "/tmp"
    ]
  }
}
